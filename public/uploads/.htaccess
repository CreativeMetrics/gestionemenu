# Le foto caricate non devono mai essere eseguite come script.
<FilesMatch "\.(php|php\d|phtml|pl|py|cgi|sh)$">
    Require all denied
</FilesMatch>

# "php_flag" funziona solo se Apache esegue PHP come proprio modulo (mod_php). Su hosting con
# PHP-FPM (comune su Plesk) questa direttiva manda in errore l'intero .htaccess, facendo
# rispondere 500 a QUALSIASI richiesta in questa cartella, comprese le foto stesse: per questo
# va dentro <IfModule>, così viene semplicemente ignorata dove non si applica.
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
